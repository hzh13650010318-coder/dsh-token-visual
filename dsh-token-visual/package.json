{
  "name": "dsh-token-visual",
  "version": "1.0.0",
  "description": "Token 余额胶囊与「Token余额」设置页：余额自动取自当前模型所属服务商的配置（baseURL + 凭据），支持余额警戒值、充值入口、近30天消耗曲线与消耗日历；不支持的模型显示红色提示。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "token",
    "balance",
    "quota"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-agent-default-model": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-sandbox-policy": "*",
    "react": "^18.2.0"
  }
}
